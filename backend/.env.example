# Copy this file to backend/.env and fill in real values. backend/.env is
# gitignored and must never be committed. Placeholders only below — no real
# credentials, hosts or secrets.

# --- Database ----------------------------------------------------------------
DB_HOST=<host>
DB_PORT=5432
DB_NAME=lis_marina_permata_dev
DB_USER=<user>
DB_PASSWORD=<password>

# --- Deployment environment ----------------------------------------------------
# "development" or "production". Controls only whether FastAPI's /docs,
# /redoc and /openapi.json exist (OD-S2) — never used to relax authentication.
ENVIRONMENT=development

# --- Security / authentication (M9.1a) ---------------------------------------
# REQUIRED. No default is provided anywhere in the application — it refuses
# to start without this. Generate a real secret per deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse this value across environments, never commit a real value.
JWT_SECRET_KEY=<generate-a-long-random-secret-and-put-it-here>
JWT_ALGORITHM=HS256
# 8-hour shift, no refresh token (OD-S1).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins. Empty means no
# cross-origin access at all — never "*" (OD-S2 / design §9).
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- SIMRS Integration (outbound only; unrelated to inbound auth — OD-S3) ----
# SIMRS_BASE_URL=
# SIMRS_ENDPOINT=/api/v1/lis/results
# SIMRS_TIMEOUT=15
# SIMRS_API_KEY=
